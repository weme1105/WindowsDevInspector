<Window x:Class="WindowsDevInspector.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="WindowsDevInspector"
        MinHeight="720"
        MinWidth="1180"
        Height="800"
        Width="1280"
        Background="#F5F7FA">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#162033" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="ResultCellTextBlockStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="Foreground" Value="#162033" />
        </Style>
        <Style x:Key="ResultListViewItemStyle" TargetType="ListViewItem">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="Expander">
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="#FFFFFF"
                BorderBrush="#D7DEE8"
                BorderThickness="0,0,1,0"
                Padding="22">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="WindowsDevInspector"
                               FontSize="22"
                               FontWeight="Bold" />
                    <TextBlock Text="Windows 開發環境檢查"
                               Margin="0,4,0,22"
                               Foreground="#5D6B82" />

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="技術選擇"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <TextBox x:Name="TechnologySearchTextBox"
                                 Grid.Column="1"
                                 MinHeight="28"
                                 Margin="16,0,0,0"
                                 Padding="8,3"
                                 VerticalContentAlignment="Center"
                                 TextChanged="TechnologySearchTextBox_TextChanged"
                                 ToolTip="輸入關鍵字後，符合的技術會排序到各分類最上方。" />
                    </Grid>
                </StackPanel>

                <ScrollViewer Grid.Row="1"
                              Margin="0,0,0,14"
                              VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding TechnologyGroups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Expander Header="{Binding DisplayName}"
                                          IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                                          FontWeight="SemiBold"
                                          Margin="0,0,0,10">
                                    <ItemsControl ItemsSource="{Binding Technologies}"
                                                  Margin="0,10,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox Content="{Binding Name}"
                                                          IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Expander>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel Grid.Row="2">
                    <Button x:Name="SaveOptionsButton"
                            Content="儲存選項"
                            Click="SaveOptionsButton_Click"
                            Margin="0,0,0,10" />
                    <Button x:Name="ToggleTechnologySelectionButton"
                            Content="勾選全部"
                            Click="ToggleTechnologySelectionButton_Click"
                            Margin="0,0,0,10" />
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="96" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="檢查併發數"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold" />
                        <ComboBox x:Name="ScanConcurrencyComboBox"
                                  Grid.Column="1"
                                  ItemsSource="{Binding ScanConcurrencyOptions}"
                                  SelectedItem="{Binding SelectedScanConcurrency, Mode=TwoWay}"
                                  MinHeight="32"
                                  HorizontalContentAlignment="Center" />
                    </Grid>
                    <Button x:Name="StartScanButton"
                            Content="開始檢查"
                            Click="StartScanButton_Click"
                            Background="#2251A4"
                            BorderBrush="#2251A4"
                            Foreground="#FFFFFF" />
                    <TextBlock Text="可使用預設建議，或用勾選全部/取消勾選全部快速調整；分類標題只用來瀏覽。"
                               TextWrapping="Wrap"
                               Margin="0,12,0,0"
                               Foreground="#6C778B" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Margin="26">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="190" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="檢查結果"
                               FontSize="26"
                               FontWeight="Bold" />
                    <TextBlock Text="非 PASS 項目會優先顯示；PASS 項目會排在最後。"
                               Foreground="#5D6B82"
                               Margin="0,4,0,0" />
                    <TextBlock x:Name="ScoreTextBlock"
                               Text="Score --/100"
                               Foreground="#42516A"
                               FontWeight="SemiBold"
                               Margin="0,8,0,0" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            VerticalAlignment="Top">
                    <CheckBox x:Name="HidePassResultsCheckBox"
                              Content="隱藏 PASS 結果"
                              VerticalAlignment="Center"
                              Margin="0,0,12,0"
                              Checked="HidePassResultsCheckBox_Changed"
                              Unchecked="HidePassResultsCheckBox_Changed" />
                    <Button x:Name="ExportReportButton"
                            Content="匯出報告"
                            Click="ExportReportButton_Click"
                            Margin="0,0,12,0" />
                </StackPanel>
                <Border DockPanel.Dock="Right"
                        Background="#EAF1FB"
                        BorderBrush="#C7D8F2"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12,7">
                    <TextBlock x:Name="ScanStatusTextBlock"
                               Text="尚未掃描"
                               Foreground="#2251A4"
                               FontWeight="SemiBold" />
                </Border>
            </DockPanel>

            <ListView Grid.Row="1"
                      x:Name="ResultsListView"
                      ItemsSource="{Binding Results}"
                      ItemContainerStyle="{StaticResource ResultListViewItemStyle}"
                      BorderBrush="#D7DEE8"
                      BorderThickness="1"
                      Background="#FFFFFF">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="修正" Width="70">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelectedForFix, Mode=TwoWay}"
                                              IsEnabled="{Binding IsFixSelectable}"
                                              Visibility="{Binding IsFixSelectable, Converter={StaticResource BooleanToVisibilityConverter}}"
                                              HorizontalAlignment="Center"
                                              Margin="0" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="狀態" Width="90">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Style="{StaticResource ResultCellTextBlockStyle}" Text="{Binding Severity}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="分類" Width="150">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Style="{StaticResource ResultCellTextBlockStyle}" Text="{Binding Category}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="項目" Width="240">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Style="{StaticResource ResultCellTextBlockStyle}" Text="{Binding Name}" ToolTip="{Binding Name}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="目前值" Width="260">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Style="{StaticResource ResultCellTextBlockStyle}" Text="{Binding CurrentValue}" ToolTip="{Binding FullCurrentValue}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>

            <Border Grid.Row="2"
                    DataContext="{Binding SelectedItem, ElementName=ResultsListView}"
                    Background="#FFFFFF"
                    BorderBrush="#D7DEE8"
                    BorderThickness="1"
                    Padding="18"
                    Margin="0,18,0,0">
                <StackPanel>
                    <TextBlock Text="詳細資訊"
                               FontSize="18"
                               FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Name, TargetNullValue=請從結果列表選取一列}"
                               TextWrapping="Wrap"
                               Margin="0,10,0,0"
                               FontWeight="SemiBold"
                               Foreground="#42516A" />
                    <TextBlock Text="{Binding FullCurrentValue, TargetNullValue=開始檢查後，選取結果列即可查看完整目前值。}"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0"
                               Foreground="#42516A" />
                    <TextBlock Text="{Binding ExpectedValue, StringFormat=Expected: {0}}"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0"
                               Foreground="#5D6B82" />
                    <TextBlock Text="{Binding Impact, StringFormat=Impact: {0}}"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0"
                               Foreground="#5D6B82" />
                </StackPanel>
            </Border>

            <Grid Grid.Row="3" Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="330" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="FixAllButton"
                        Content="全部修正"
                        Click="FixAllButton_Click" />
                <ComboBox x:Name="BackupComboBox"
                          Grid.Column="1"
                          Margin="12,0,0,0"
                          ItemsSource="{Binding BackupFiles}"
                          DisplayMemberPath="DisplayName" />
                <Button x:Name="RestoreLatestBackupButton"
                        Grid.Column="2"
                        Content="還原備份"
                        Click="RestoreLatestBackupButton_Click"
                        Margin="12,0,0,0" />
                <Button x:Name="StartFixButton"
                        Grid.Column="4"
                        Content="修正勾選項目"
                        Click="StartFixButton_Click"
                        MinWidth="120"
                        HorizontalAlignment="Right" />
            </Grid>
        </Grid>
    </Grid>
</Window>
