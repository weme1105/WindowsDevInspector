<Window x:Class="WindowsDevInspector.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="WindowsDevInspector"
        MinHeight="720"
        MinWidth="1180"
        Height="800"
        Width="1280"
        Background="#F5F7FA">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="14,6" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#162033" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style TargetType="Expander">
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="#FFFFFF"
                BorderBrush="#D7DEE8"
                BorderThickness="0,0,1,0"
                Padding="22">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="WindowsDevInspector"
                               FontSize="22"
                               FontWeight="Bold" />
                    <TextBlock Text="Windows 開發環境檢查"
                               Margin="0,4,0,22"
                               Foreground="#5D6B82" />

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="技術選擇"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <TextBox x:Name="TechnologySearchTextBox"
                                 Grid.Column="1"
                                 MinHeight="28"
                                 Margin="16,0,0,0"
                                 Padding="8,3"
                                 VerticalContentAlignment="Center"
                                 TextChanged="TechnologySearchTextBox_TextChanged"
                                 ToolTip="輸入關鍵字後，符合的技術會排序到各分類最上方。" />
                    </Grid>

                    <ScrollViewer MaxHeight="560" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding TechnologyGroups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Expander Header="{Binding DisplayName}"
                                              IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                                              FontWeight="SemiBold"
                                              Margin="0,0,0,10">
                                        <ScrollViewer MaxHeight="150"
                                                      Margin="0,10,0,0"
                                                      VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding Technologies}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <CheckBox Content="{Binding Name}"
                                                                  IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Expander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom">
                    <Button x:Name="StartScanButton"
                            Content="開始檢查"
                            Click="StartScanButton_Click"
                            Background="#2251A4"
                            BorderBrush="#2251A4"
                            Foreground="#FFFFFF" />
                    <TextBlock Text="目前會先把已選技術轉成檢查結果；下一步會接上真實掃描器。"
                               TextWrapping="Wrap"
                               Margin="0,12,0,0"
                               Foreground="#6C778B" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="26">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="190" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="檢查結果"
                               FontSize="26"
                               FontWeight="Bold" />
                    <TextBlock Text="非 PASS 項目會優先顯示；PASS 項目會排在最後。"
                               Foreground="#5D6B82"
                               Margin="0,4,0,0" />
                </StackPanel>
                <Border DockPanel.Dock="Right"
                        Background="#EAF1FB"
                        BorderBrush="#C7D8F2"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12,7">
                    <TextBlock x:Name="ScanStatusTextBlock"
                               Text="尚未掃描"
                               Foreground="#2251A4"
                               FontWeight="SemiBold" />
                </Border>
            </DockPanel>

            <ListView Grid.Row="1"
                      ItemsSource="{Binding Results}"
                      BorderBrush="#D7DEE8"
                      BorderThickness="1"
                      Background="#FFFFFF">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="狀態" Width="90" DisplayMemberBinding="{Binding Severity}" />
                        <GridViewColumn Header="分類" Width="150" DisplayMemberBinding="{Binding Category}" />
                        <GridViewColumn Header="項目" Width="240" DisplayMemberBinding="{Binding Name}" />
                        <GridViewColumn Header="目前值" Width="260" DisplayMemberBinding="{Binding CurrentValue}" />
                        <GridViewColumn Header="修正" Width="100" DisplayMemberBinding="{Binding CanFix}" />
                    </GridView>
                </ListView.View>
            </ListView>

            <Border Grid.Row="2"
                    Background="#FFFFFF"
                    BorderBrush="#D7DEE8"
                    BorderThickness="1"
                    Padding="18"
                    Margin="0,18,0,0">
                <StackPanel>
                    <TextBlock Text="詳細資訊"
                               FontSize="18"
                               FontWeight="SemiBold" />
                    <TextBlock Text="搜尋會把符合關鍵字的技術排到各分類最上方，不符合的項目會保留原始順序往下排。"
                               TextWrapping="Wrap"
                               Margin="0,10,0,0"
                               Foreground="#42516A" />
                    <TextBlock Text="開始檢查後，已支援的技術會顯示支援狀態；未支援的技術會以 Info 顯示。"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0"
                               Foreground="#42516A" />
                </StackPanel>
            </Border>

            <DockPanel Grid.Row="3" Margin="0,18,0,0">
                <Button Content="批次修正"
                        IsEnabled="False"
                        DockPanel.Dock="Left" />
                <Button Content="開始修正"
                        IsEnabled="False"
                        DockPanel.Dock="Right" />
            </DockPanel>
        </Grid>
    </Grid>
</Window>
