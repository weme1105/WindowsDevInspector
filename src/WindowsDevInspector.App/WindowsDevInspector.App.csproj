<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\WindowsDevInspector.Core\WindowsDevInspector.Core.csproj" />
    <ProjectReference Include="..\WindowsDevInspector.Windows\WindowsDevInspector.Windows.csproj" />
    <ProjectReference Include="..\WindowsDevInspector.Remediation\WindowsDevInspector.Remediation.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <Target Name="CopyElevatedWorker" AfterTargets="Build">
    <ItemGroup>
      <ElevatedWorkerOutput Include="$(MSBuildProjectDirectory)\..\WindowsDevInspector.ElevatedWorker\bin\$(Configuration)\net10.0-windows\WindowsDevInspector.ElevatedWorker.*" />
    </ItemGroup>
    <Copy SourceFiles="@(ElevatedWorkerOutput)"
          DestinationFolder="$(OutputPath)"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
